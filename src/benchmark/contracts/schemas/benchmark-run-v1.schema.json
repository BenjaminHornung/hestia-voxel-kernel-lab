{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hestia.invalid/schemas/benchmark-run-v1.schema.json",
  "title": "Hestia Benchmark Hardware Cell and Run Hierarchy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hardwareCellId", "source", "scenarioId", "scenarioVersion", "hardwareProfileId", "environment", "measurementEligible", "measurementEligibilityReasons", "browserProcesses"],
  "properties": {
    "schemaVersion": { "const": "benchmark-hardware-cell-v1" },
    "hardwareCellId": { "$ref": "#/$defs/id" },
    "source": { "$ref": "#/$defs/source" },
    "scenarioId": { "enum": ["mesh-golden-world-v1", "mesh-density-sweep-v1", "scheduler-steady-v1", "scheduler-burst-v1", "brush-stress-v1", "navigation-leak-v1", "backend-fixture-v1"] },
    "scenarioVersion": { "const": 1 },
    "hardwareProfileId": { "$ref": "#/$defs/id" },
    "environment": { "$ref": "#/$defs/environment" },
    "measurementEligible": { "type": "boolean" },
    "measurementEligibilityReasons": { "type": "array", "items": { "$ref": "#/$defs/invalidReason" } },
    "browserProcesses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/browserProcess" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "metricRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$" },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "hardwareString": { "type": "string", "minLength": 1, "maxLength": 2048, "not": { "const": "unknown" } },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)[a-z0-9](?:[a-z0-9._/-]*[a-z0-9._-])?$" },
    "pathList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "uint32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "value": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
      }
    },
    "availabilityUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "sourceRef", "reasonCode"],
      "properties": {
        "status": { "enum": ["unknown", "unsupported", "not-requested", "not-active", "permission-denied", "blocked", "error"] },
        "value": { "type": "null" },
        "sourceRef": { "$ref": "#/$defs/id" },
        "reasonCode": { "$ref": "#/$defs/id" }
      }
    },
    "availabilityString": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/nonEmpty" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/nonEmpty" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityHardwareString": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/hardwareString" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/hardwareString" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityId": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/id" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/id" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityDigest": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/sha256" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/sha256" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityPathList": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/pathList" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/pathList" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityBoolean": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "type": "boolean" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "type": "boolean" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityPositiveInteger": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/positiveInteger" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/positiveInteger" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityNonNegativeInteger": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/nonNegativeInteger" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/nonNegativeInteger" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityPositiveNumber": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/positiveNumber" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/positiveNumber" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityStringArray": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityTier": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["H1", "H2", "H3"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["H1", "H2", "H3"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityGateRole": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["correctness-only", "performance-primary", "guardrail", "informational"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["correctness-only", "performance-primary", "guardrail", "informational"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityVsync": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["enabled", "disabled", "platform-default"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["enabled", "disabled", "platform-default"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityPowerSource": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["ac", "battery"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["ac", "battery"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityVisibility": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["visible", "hidden"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["visible", "hidden"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityFocus": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["focused", "unfocused"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["focused", "unfocused"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "availabilityThermal": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "enum": ["nominal", "throttled", "not-observable"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "enum": ["nominal", "throttled", "not-observable"] }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "batteryState": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "not-applicable" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "percent"], "properties": { "status": { "const": "reported" }, "percent": { "type": "number", "minimum": 0, "maximum": 100 } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "const": "unavailable" }, "reason": { "$ref": "#/$defs/nonEmpty" } } }
      ]
    },
    "availabilityBattery": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/batteryState" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/batteryState" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "competingLoad": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "none" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "detail"], "properties": { "status": { "const": "documented" }, "detail": { "$ref": "#/$defs/nonEmpty" } } }
      ]
    },
    "availabilityCompetingLoad": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "$ref": "#/$defs/competingLoad" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "$ref": "#/$defs/competingLoad" }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "capabilityAvailability": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "observed" }, "value": { "const": true }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["stable", "experimental", "platform-specific"] } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "sourceRef", "stability"], "properties": { "status": { "const": "declared" }, "value": { "const": true }, "sourceRef": { "$ref": "#/$defs/id" }, "stability": { "enum": ["owner-binding", "run-config", "browser-default"] } } },
        { "$ref": "#/$defs/availabilityUnavailable" }
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "semanticSha256", "sourceFileSetSha256", "sourcePaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/positiveInteger" },
        "semanticSha256": { "$ref": "#/$defs/availabilityDigest" },
        "sourceFileSetSha256": { "$ref": "#/$defs/availabilityDigest" },
        "sourcePaths": { "$ref": "#/$defs/availabilityPathList" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceFileSetSha256", "sourcePaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/positiveInteger" },
        "sourceFileSetSha256": { "$ref": "#/$defs/availabilityDigest" },
        "sourcePaths": { "$ref": "#/$defs/availabilityPathList" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithmVersion", "rootPath", "sha256", "fileCount", "totalBytes"],
      "properties": {
        "algorithmVersion": { "const": "hestia-benchmark-build-sha256-v1" },
        "rootPath": { "const": "dist" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fileCount": { "$ref": "#/$defs/positiveInteger" },
        "totalBytes": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "repositoryUrl", "commitSha", "commitTreeSha", "worktree", "build", "fixture", "candidate"],
      "properties": {
        "schemaVersion": { "const": "benchmark-source-provenance-v1" },
        "repositoryUrl": { "const": "https://github.com/BenjaminHornung/hestia-voxel-kernel-lab" },
        "commitSha": { "$ref": "#/$defs/gitSha" },
        "commitTreeSha": { "$ref": "#/$defs/gitSha" },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "statusCommand", "statusOutputSha256", "submodules"],
          "properties": {
            "state": { "const": "clean" },
            "statusCommand": { "const": "git status --porcelain=v2 -z --untracked-files=all --ignore-submodules=none" },
            "statusOutputSha256": { "const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" },
            "submodules": { "type": "array", "maxItems": 0 }
          }
        },
        "build": { "$ref": "#/$defs/build" },
        "fixture": { "$ref": "#/$defs/fixture" },
        "candidate": { "$ref": "#/$defs/candidate" }
      }
    },
    "invalidReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "phase"],
      "properties": {
        "code": { "enum": ["source-dirty", "source-sha-mismatch", "source-tree-mismatch", "build-digest-mismatch", "fixture-contract-mismatch", "candidate-contract-mismatch", "scenario-contract-mismatch", "run-plan-mismatch", "environment-incomplete", "browser-version-mismatch", "required-capability-missing", "document-hidden", "document-unfocused", "background-tabs-present", "power-state-mismatch", "thermal-throttling", "clock-invalid", "sample-invalid", "gpu-disjoint", "context-lost", "console-error", "page-error", "request-failure", "http-error", "process-crash", "operator-abort", "infrastructure-failure"] },
        "detail": { "$ref": "#/$defs/nonEmpty" },
        "phase": { "enum": ["cold", "warmup", "measurement", "stress", "trace", "leak"] }
      }
    },
    "parameter": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "const": "seed" }, "value": { "$ref": "#/$defs/nonNegativeInteger" } } },
        { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "const": "backend" }, "value": { "enum": ["raw-webgpu", "three-webgl2"] } } },
        { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "const": "mesher" }, "value": { "enum": ["greedy", "greedy-ao", "not-applicable", "visible"] } } },
        { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "const": "chunk-edge" }, "value": { "enum": [32, 64] } } },
        { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "const": "worker-count" }, "value": { "$ref": "#/$defs/nonNegativeInteger" } } },
